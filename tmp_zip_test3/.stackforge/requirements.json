{
  "version": 1,
  "presets": {
    "cloud": "gcp",
    "orchestrator": "cloud-run",
    "ci": "gcp-cloud-build"
  },
  "options": {
    "region": "europe-west1",
    "environments": [
      "production"
    ],
    "database": "mysql",
    "databaseMode": "standard",
    "access": "public_https",
    "scale": "medium",
    "runtime": "java"
  }
}
